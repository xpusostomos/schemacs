;; The schemacs side of the indentation differential. Usage:
;;   guile --no-auto-compile -L . -L "$SITE" -s ours-indent.scm STYLE FILE [cpp]
;; The mode replay is `tools/cc-cgbs-diff/ours-dump.scm''s, then
;; `c-guess-basic-syntax' and `c-get-syntactic-indentation' per line
;; start, with `*c-syntactic-context*' bound as `c-indent-line' binds it.
(import (scheme base) (scheme write)
        (schemacs buffer) (schemacs editfns)
        (schemacs syntax) (schemacs cmds)
        (schemacs progmodes cc-defs) (schemacs progmodes cc-langs)
        (schemacs progmodes cc-vars) (schemacs progmodes cc-styles)
        (schemacs progmodes cc-engine)
        (schemacs progmodes cc-align))
(define args (cdr (command-line)))
(define style (car args))
(define file (cadr args))
(define cpp? (and (pair? (cddr args)) (string=? (caddr args) "cpp")))
(define mode (if cpp? 'c++-mode 'c-mode))
(define b (get-buffer-create "indent"))
(set-buffer b)
(call-with-input-file file
  (lambda (p) (let loop () (let ((c (read-char p))) (unless (eof-object? c) (insert (string c)) (loop))))))
(set-buffer-local-value! b 'major-mode mode)
(set-buffer-local-value! b 'parse-sexp-ignore-comments #t)
(set-syntax-table (if cpp?
                      ((c-lang-const c-make-mode-syntax-table c++))
                      ((c-lang-const c-make-mode-syntax-table c))))
(parameterize ((*c-buffer-is-cc-mode* mode))
  (if cpp? (c-init-language-vars c++-mode) (c-init-language-vars c-mode))
  (c-set-style style)
  (c-setup-paragraph-variables)
  (c-clear-found-types)
  (c-make-noise-macro-regexps)
  (c-make-macro-with-semi-re)
  (when cpp?
    (set!c-new-BEG (point-min))
    (set!c-new-END (point-max))
    (c-restore-<>-properties (point-min) (point-max) 0))
  (goto-char (point-min))
  (let loop ()
    (unless (>= (point) (point-max))
      (let ((pos (begin (beginning-of-line) (point))))
        (display "(") (display (number->string pos)) (display " ")
        (guard (e (else (display "error")))
          (let ((syntax (c-guess-basic-syntax)))
            (parameterize ((*c-syntactic-context* syntax))
              (display (number->string (c-get-syntactic-indentation syntax))))))
        (display ")") (newline))
      (forward-line 1)
      (loop))))
