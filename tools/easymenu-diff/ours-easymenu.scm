(import (scheme base) (scheme write)
        (only (guile) 1+ 1- catch throw while format)
        (schemacs editor buffer) (schemacs editor editfns)
        (schemacs editor keymap) (schemacs editor command)
        (schemacs editor menu-bar)
        (schemacs editor easymenu))
(define (pr x)
  (cond ((or (null? x) (eq? x #f)) (display "nil"))
        ((eq? x #t) (display "t"))
        ((symbol? x) (display (symbol->string x)))
        ((number? x) (display (number->string x)))
        ((string? x) (write x))
        ((vector? x)
         (display "[")
         (let loop ((i 0))
           (unless (>= i (vector-length x))
             (if (> i 0) (display " "))
             (pr (vector-ref x i))
             (loop (+ i 1))))
         (display "]"))
        ((pair? x)
         (display "(") (pr (car x))
         (let loop ((t (cdr x)))
           (cond ((pair? t) (display " ") (pr (car t)) (loop (cdr t)))
                 ((or (null? t) (eq? t #f)) #f)
                 (else (display " . ") (pr t))))
         (display ")"))
        (else (display "proc"))))
