(import (scheme base) (scheme write)
        (schemacs buffer) (schemacs editfns)
        (schemacs syntax) (schemacs cmds)
        (schemacs progmodes cc-defs) (schemacs progmodes cc-langs)
        (schemacs progmodes cc-vars) (schemacs progmodes cc-styles)
        (schemacs progmodes cc-engine))
(define (nil? x) (or (eq? x #f) (null? x)))
(define (ep x)
  (cond ((nil? x) (display "nil"))
        ((symbol? x) (display (symbol->string x)))
        ((number? x) (display (number->string x)))
        ((string? x) (write x))
        ((pair? x)
         (display "(")
         (let loop ((p x))
           (ep (car p))
           (let ((d (cdr p)))
             (cond ((pair? d) (display " ") (loop d))
                   ((nil? d) #f)
                   (else (display " . ") (ep d)))))
         (display ")"))
        (else (write x))))
(define file (cadr (command-line)))
(define b (get-buffer-create "cgbs"))
(set-buffer b)
(call-with-input-file file
  (lambda (p) (let loop () (let ((c (read-char p))) (unless (eof-object? c) (insert (string c)) (loop))))))
(set-buffer-local-value! b 'major-mode 'c-mode)
(set-buffer-local-value! b 'parse-sexp-ignore-comments #t)
(set-syntax-table ((c-lang-const c-make-mode-syntax-table c)))
(parameterize ((*c-buffer-is-cc-mode* 'c-mode))
  (c-init-language-vars c-mode)
  (c-set-style "gnu")
  (c-setup-paragraph-variables)
  (c-clear-found-types)
  (c-make-noise-macro-regexps)
  (c-make-macro-with-semi-re)
  (goto-char (point-min))
  (let loop ()
    (unless (>= (point) (point-max))
      (let ((pos (begin (beginning-of-line) (point))))
        (display "(") (display (number->string pos)) (display " ")
        (ep (c-guess-basic-syntax))
        (display ")") (newline))
      (forward-line 1)
      (loop))))
