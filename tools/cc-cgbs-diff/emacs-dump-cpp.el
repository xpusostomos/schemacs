(require 'cc-mode)
(let ((file (car command-line-args-left)))
  (find-file file)
  (c++-mode)
  (c-set-style "gnu")
  (goto-char (point-min))
  (while (< (point) (point-max))
    (let ((pos (progn (beginning-of-line) (point))))
      (prin1 (list pos (c-guess-basic-syntax)))
      (terpri))
    (forward-line 1)))
