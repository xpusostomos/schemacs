;;; -*- lexical-binding: t -*-
(require 'cc-mode)
(defun probe (pos fn)
  (save-excursion
    (goto-char pos)
    (c-clear-found-types)
    (condition-case nil
        (let ((res (funcall fn))) (list res (point)))
      (error (list 'error (point))))))
(defun dump ()
  (let ((z (point-max)) (out '()))
    (dotimes (i z)
      (let ((pos (1+ i)))
        (dolist (spec
                 '(("D" (lambda () (c-forward-declarator)))
                   ("E" (lambda () (c-forward-declarator (point-max) t t)))
                   ("G" (lambda () (and (eq (char-after) ?\() (c-forward-decl-arglist nil nil))))
                   ("H" (lambda () (and (eq (char-after) ?\() (c-forward-decl-arglist t t))))
                   ("P" (lambda () (c-forward-primary-expression)))
                   ("Q" (lambda () (c-forward-primary-expression (point-max) t)))
                   ("C" (lambda () (c-forward-constraint-clause)))
                   ("R" (lambda () (c-forward-c++-requires-clause)))
                   ("I" (lambda () (c-in-id-arglist)))
                   ("X" (lambda () (c-forward-class-decl)))
                   ("M" (lambda () (c-back-over-member-initializer-braces)))
                   ("F" (lambda () (c-forward-decl-or-cast-1
                                    (max (point-min) (1- (point))) 'top nil)))
                   ("A" (lambda () (c-at-toplevel-p)))
                   ("J" (lambda () (c-just-after-func-arglist-p)))
                   ("K" (lambda () (and (eq (char-after) ?\[)
                                        (c-looking-at-c++-lambda-expression))))
                   ("B" (lambda () (and (eq (char-after) ?{)
                                        (c-backward-over-lambda-expression))))
                   ("L" (lambda () (and (eq (char-after) ?{)
                                        (c-looking-at-statement-block-1))))
                   ("S" (lambda () (and (eq (char-after) ?{)
                                        (c-looking-at-statement-block))))
                   ("N" (lambda () (and (eq (char-after) ?{)
                                        (c-looking-at-decl-block nil))))
                   ("O" (lambda () (c-directly-in-class-called-p "C")))
                   ("U" (lambda () (c-search-uplist-for-classkey (c-parse-state))))
                   ("V" (lambda () (c-back-over-member-initializers)))
                   ("W" (lambda () (c-do-declarators (point-max) nil nil nil nil)))
                   ("Y" (lambda () (c-forward-objc-directive)))
                   ("a" (lambda () (c-forward-label)))
                   ("b" (lambda () (c-in-knr-argdecl)))
                   ("c" (lambda () (c-skip-conditional) nil))
                   ("d" (lambda () (c-after-conditional)))
                   ("e" (lambda () (c-after-special-operator-id)))
                   ("f" (lambda () (and (eq (char-after) ?{)
                                        (c-backward-to-block-anchor) nil)))
                   ("g" (lambda () (and (eq (char-after) ?{)
                                        (c-backward-to-decl-anchor) nil)))
                   ("h" (lambda () (c-search-decl-header-end) nil))
                   ("i" (lambda () (c-beginning-of-decl-1)))
                   ("j" (lambda () (c-end-of-decl-1)))
                   ("k" (lambda () (c-forward-decl-or-cast-1
                                    (c-point 'bosws) 'top nil)))
                   ("m" (lambda () (c-most-enclosing-decl-block (c-parse-state))))
                   ("n" (lambda () (c-cheap-inside-bracelist-p (c-parse-state))))
                   ("o" (lambda () (and (eq (char-after) ?{)
                                        (c-backward-typed-enum-colon))))
                   ("p" (lambda () (and (eq (char-after) ?{)
                                        (c-backward-over-enum-header))))
                   ("q" (lambda () (and (eq (char-after) ?{)
                                        (c-at-enum-brace))))
                   ("r" (lambda () (c-laomib-loop nil)))
                   ("s" (lambda () (and (eq (char-after) ?{)
                                        (c-looking-at-or-maybe-in-bracelist))))
                   ("t" (lambda ()
                          (let ((paren-state (c-parse-state)))
                            (let ((brace (c-most-enclosing-brace paren-state)))
                              (and brace
                                   (save-excursion
                                     (goto-char brace)
                                     (eq (char-after) ?{))
                                   (c-at-bracelist-p brace paren-state))))))
                   ("u" (lambda () (c-strip-conses (c-parse-state))))))
          (let* ((tag (car spec))
                 (r (probe pos (cadr spec))))
            (setq out (cons (format "%s %d %s %d" tag pos
                                    (prin1-to-string (car r)) (cadr r))
                            out))))))
    (with-temp-file (nth 0 command-line-args-left)
      (dolist (l (nreverse out)) (insert l "\n")))))
(with-temp-buffer
  (insert-file-contents (nth 1 command-line-args-left))
  (setq buffer-file-name (nth 1 command-line-args-left))
  (c-mode)
  (setq font-lock-support-mode nil)
  (setq-local syntax-propertize-function nil)
  (syntax-ppss-flush-cache (point-min))
  (let ((inhibit-modification-hooks t))
    (remove-text-properties (point-min) (point-max)
                            '(category nil syntax-table nil)))
  (dump))
(kill-emacs 0)
