(import (scheme base) (scheme file) (scheme write)
        (only (schemacs editor buffer) allocate-buffer set-buffer
              set-buffer-local-value! buffer-local-value current-buffer)
        (only (schemacs editor editfns) insert goto-char point point-max
              char-after char-before save-excursion)
        (only (schemacs editor search) looking-at)
        (only (schemacs editor syntax) set-syntax-table))
(import (only (schemacs editor cc-defs) c-lang-const *c-buffer-is-cc-mode*))
(import (schemacs editor cc-langs) (schemacs editor cc-vars)
        (schemacs editor cc-engine))

(define (slurp path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((acc '()))
        (let ((c (read-char port)))
          (if (eof-object? c) (list->string (reverse acc)) (loop (cons c acc))))))))

(define (emacs-print x)
  (cond ((eq? x #t) "t")
        ((eq? x #f) "nil")
        ((null? x) "nil")
        ((char? x) (number->string (char->integer x)))
        ((integer? x) (number->string x))
        ((symbol? x) (symbol->string x))
        ((string? x) (string-append "\"" x "\""))
        ((pair? x)
         (string-append "(" (emacs-print (car x))
                        (let loop ((d (cdr x)))
                          (cond ((null? d) ")")
                                ((pair? d)
                                 (string-append " " (emacs-print (car d))
                                                (loop (cdr d))))
                                (else (string-append " . " (emacs-print d) ")"))))))
        (else (format #f "~s" x))))

(define fixture (slurp (caddr (command-line))))
(define b (allocate-buffer))
(set-buffer b)
(insert fixture)
(set-buffer-local-value! b 'major-mode 'c++-mode)
(set-buffer-local-value! b 'parse-sexp-ignore-comments #t)
(c-init-language-vars c++-mode)
(set-syntax-table ((c-lang-const c-make-mode-syntax-table c++)))

(define (probe pos thunk)
  (save-excursion
    (goto-char pos)
    (c-clear-found-types)
    (guard (e (#t (list 'error (point))))
      (let ((res (thunk))) (list res (point))))))

(define out '())
(define (emit tag pos res)
  (set! out (cons (format #f "~a ~a ~a ~a" tag pos
                          (emacs-print (car res)) (cadr res))
                  out)))

(define (run spec pos)
  (emit (car spec) pos (probe pos (cdr spec))))

(parameterize ((*c-buffer-is-cc-mode* 'c++-mode))
  (let ((z (point-max)))
    (let loop ((pos 1))
      (when (<= pos z)
        (for-each
         (lambda (spec) (run spec pos))
         (list (cons "D" (lambda () (c-forward-declarator)))
               (cons "E" (lambda () (c-forward-declarator (point-max) #t #t)))
               (cons "G" (lambda () (and (eq? (char-after pos) #\() (c-forward-decl-arglist #f #f))))
               (cons "H" (lambda () (and (eq? (char-after pos) #\() (c-forward-decl-arglist #t #t))))
               (cons "P" (lambda () (c-forward-primary-expression)))
               (cons "Q" (lambda () (c-forward-primary-expression (point-max) #t)))
               (cons "C" (lambda () (c-forward-constraint-clause)))
               (cons "R" (lambda () (c-forward-c++-requires-clause)))
               (cons "I" (lambda () (c-in-id-arglist)))
               (cons "X" (lambda () (c-forward-class-decl)))
               (cons "M" (lambda () (c-back-over-member-initializer-braces)))))
        (loop (+ pos 1))))))

(call-with-output-file (cadr (command-line))
  (lambda (p) (for-each (lambda (l) (display l p) (newline p)) (reverse out))))
