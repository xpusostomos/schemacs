(import (scheme base) (scheme file) (scheme write)
        (only (schemacs editor buffer) allocate-buffer set-buffer
              set-buffer-local-value! buffer-local-value current-buffer)
        (only (schemacs editor editfns) insert goto-char point point-min
              point-max char-after char-before save-excursion)
        (only (schemacs editor search) looking-at)
        (only (schemacs editor syntax) set-syntax-table))
(import (only (schemacs editor cc-defs) c-lang-const *c-buffer-is-cc-mode*))
(import (schemacs editor cc-langs) (schemacs editor cc-vars)
        (schemacs editor cc-engine))

(define (slurp path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((acc '()))
        (let ((c (read-char port)))
          (if (eof-object? c) (list->string (reverse acc)) (loop (cons c acc))))))))

(define (emacs-print x)
  (cond ((eq? x #t) "t")
        ((eq? x #f) "nil")
        ((null? x) "nil")
        ((char? x) (number->string (char->integer x)))
        ((integer? x) (number->string x))
        ((symbol? x) (symbol->string x))
        ((vector? x)
         (string-append "[" (let loop ((l (vector->list x)) (acc ""))
                            (if (null? l) acc
                                (loop (cdr l)
                                      (string-append acc
                                                     (if (string=? acc "") "" " ")
                                                     (emacs-print (car l))))))
                        "]"))
        ((string? x) (string-append "\"" x "\""))
        ((pair? x)
         (string-append "(" (emacs-print (car x))
                        (let loop ((d (cdr x)))
                          (cond ((null? d) ")")
                                ;; A cons whose cdr is #f is Elisp's proper
                                ;; list, so it prints the same way.
                                ((eq? d #f) ")")
                                ((pair? d)
                                 (string-append " " (emacs-print (car d))
                                                (loop (cdr d))))
                                (else (string-append " . " (emacs-print d) ")"))))))
        (else (format #f "~s" x))))

(define fixture (slurp (caddr (command-line))))
(define b (allocate-buffer))
(set-buffer b)
(insert fixture)
(set-buffer-local-value! b 'major-mode 'c-mode)
(set-buffer-local-value! b 'parse-sexp-ignore-comments #t)
(c-init-language-vars c-mode)
;; As the mode's own init does, so `c-at-vsemi-p' works on
;; macro-with-semicolon lines.
(c-make-macro-with-semi-re)
(set-syntax-table ((c-lang-const c-make-mode-syntax-table c)))

(define (probe pos thunk)
  (save-excursion
    (goto-char pos)
    (c-clear-found-types)
    (guard (e (#t (list 'error (point))))
      (let ((res (thunk))) (list res (point))))))

(define out '())
(define (emit tag pos res)
  (set! out (cons (format #f "~a ~a ~a ~a" tag pos
                          (emacs-print (car res)) (cadr res))
                  out)))

(define (run spec pos)
  (emit (car spec) pos (probe pos (cdr spec))))

(parameterize ((*c-buffer-is-cc-mode* 'c-mode))
  (let ((z (point-max)))
    (let loop ((pos 1))
      (when (<= pos z)
        (for-each
         (lambda (spec) (run spec pos))
         (list (cons "D" (lambda () (c-forward-declarator)))
               (cons "E" (lambda () (c-forward-declarator (point-max) #t #t)))
               (cons "G" (lambda () (and (eq? (char-after pos) #\() (c-forward-decl-arglist #f #f))))
               (cons "H" (lambda () (and (eq? (char-after pos) #\() (c-forward-decl-arglist #t #t))))
               (cons "P" (lambda () (c-forward-primary-expression)))
               (cons "Q" (lambda () (c-forward-primary-expression (point-max) #t)))
               (cons "C" (lambda () (c-forward-constraint-clause)))
               (cons "R" (lambda () (c-forward-c++-requires-clause)))
               (cons "I" (lambda () (c-in-id-arglist)))
               (cons "X" (lambda () (c-forward-class-decl)))
               (cons "M" (lambda () (c-back-over-member-initializer-braces)))
               (cons "F" (lambda () (c-forward-decl-or-cast-1
                                     (max (point-min) (- (point) 1)) 'top #f)))
               (cons "A" (lambda () (c-at-toplevel-p)))
               (cons "J" (lambda () (c-just-after-func-arglist-p)))
               (cons "K" (lambda () (and (eqv? (char-after (point)) #\[)
                                         (c-looking-at-c++-lambda-expression))))
               (cons "B" (lambda () (and (eqv? (char-after (point)) #\{)
                                         (c-backward-over-lambda-expression))))
               (cons "L" (lambda () (and (eqv? (char-after (point)) #\{)
                                         (c-looking-at-statement-block-1))))
               (cons "S" (lambda () (and (eqv? (char-after (point)) #\{)
                                         (c-looking-at-statement-block))))
               (cons "N" (lambda () (and (eqv? (char-after (point)) #\{)
                                         (c-looking-at-decl-block #f))))
               (cons "O" (lambda () (c-directly-in-class-called-p "C")))
               (cons "U" (lambda () (c-search-uplist-for-classkey (c-parse-state))))
               (cons "V" (lambda () (c-back-over-member-initializers)))
               (cons "W" (lambda () (c-do-declarators (point-max) #f #f #f #f)))
               (cons "Y" (lambda () (c-forward-objc-directive)))
               (cons "a" (lambda () (c-forward-label)))
               (cons "b" (lambda () (c-in-knr-argdecl)))
               (cons "c" (lambda () (begin (c-skip-conditional) #f)))
               (cons "d" (lambda () (c-after-conditional)))
               (cons "e" (lambda () (c-after-special-operator-id)))
               (cons "f" (lambda () (and (eqv? (char-after (point)) #\{)
                                         (begin (c-backward-to-block-anchor) #f))))
               (cons "g" (lambda () (and (eqv? (char-after (point)) #\{)
                                         (begin (c-backward-to-decl-anchor) #f))))
               (cons "h" (lambda () (begin (c-search-decl-header-end) #f)))
               (cons "i" (lambda () (c-beginning-of-decl-1)))
               (cons "j" (lambda () (c-end-of-decl-1)))
               (cons "k" (lambda () (c-forward-decl-or-cast-1
                                     (c-point 'bosws) 'top #f)))))
        (loop (+ pos 1))))))

(call-with-output-file (cadr (command-line))
  (lambda (p) (for-each (lambda (l) (display l p) (newline p)) (reverse out))))
