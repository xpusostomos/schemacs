;; The Emacs side of the line-up differential. Usage:
;;   emacs -Q --batch -l emacs-align.el FILE c|cpp
;; Each case calls one `cc-align.el' function directly at a position the
;; case names by a needle (a substring, plus a character delta), with
;; `c-syntactic-element' and `c-syntactic-context' bound to the elements
;; the case gives. Both sides print the same table; `diff' them.

(require 'cc-mode)

(defconst cases-c
  '((assign-stmt c-lineup-assignments statement-cont ("+ c;" 0) ("+ c;" 0) nil)
    (assign-arg c-lineup-assignments arglist-cont-nonempty ("b);" 0) ("bar (" 0) ("bar (" 9))
    (math-stmt c-lineup-math statement-cont ("+ c;" 0) ("+ c;" 0) nil)
    (ternary c-lineup-ternary-bodies statement-cont (": (3 * arg" 0) ("return arg % 2" 0) nil)
    (cascaded c-lineup-cascaded-calls statement-cont ("->add (19)" 0) ("result = proc" 0) nil)
    (string-cont c-lineup-string-cont statement-cont ("string." 0) ("result = prefix" 0) nil)
    (argcont c-lineup-argcont arglist-cont ("+ ddd + eee" 0) ("foo (xyz" 0) nil)
    (argcont-1 c-lineup-argcont-1 arglist-cont ("+ ddd + eee" 0) ("foo (xyz" 0) nil)
    (argcont-plus c-lineup-argcont-+ arglist-cont ("+ ddd + eee" 0) ("foo (xyz" 0) nil)
    (argcont-scan c-lineup-argcont-scan arglist-cont ("+ ddd + eee" 0) ("foo (xyz" 0) nil)
    (arglist c-lineup-arglist arglist-cont-nonempty ("+ ddd" 0) ("foo (xyz" 0) ("foo (xyz" 4))
    (arglist-intro c-lineup-arglist-intro-after-paren arglist-intro ("+ ddd" 0) ("foo (xyz" 0) nil)
    (arglist-close-under c-lineup-arglist-close-under-paren arglist-close ("b);" 0) ("bar (" 0) ("bar (" 4))
    (close-paren c-lineup-close-paren arglist-close ("b);" 0) ("bar (" 0) ("bar (" 4))
    (arglist-operators c-lineup-arglist-operators arglist-cont-nonempty ("|| at_limit" 0) ("if (x < 10" 0) ("if (x < 10" 3))
    (indent-one c-indent-one-line-block defun-block-intro ("{m+=n; n=0;}" 0) ("void bare" 17) nil)
    (indent-multi c-indent-multi-line-block brace-list-intro ("{ 17," 0) ("int *foo[] = {" 0) ("int *foo[] = {" 13))
    (item-after-paren c-lineup-item-after-paren-at-boi brace-list-intro ("{ 17," 0) ("int *foo[] = {" 0) ("int *foo[] = {" 13))
    (runin c-lineup-runin-statements statement ("puts (\"Hello" 0) ("{ puts" 2) nil)
    (knr-comment c-lineup-knr-region-comment comment-intro ("/* This is the main" 0) ("/* This is the main" 0) nil
                 (func-decl-cont "/* This is the main" 0))
    (comment-anchored c-lineup-comment comment-intro ("* continuation" 0) ("* continuation" 0) nil)
    (comment-plain c-lineup-comment comment-intro ("/* A comment" 0) ("/* A comment" 0) nil)
    (c-comments c-lineup-C-comments c ("* continuation" 0) ("/* A comment" 0) nil)
    (gcc-asm c-lineup-gcc-asm-reg arglist-cont-nonempty ("(x)" 0) ("asm (" 0) ("asm (" 4))
    (gcc-asm-colon c-lineup-gcc-asm-reg arglist-cont-nonempty ("(y)" 0) ("asm (" 0) ("asm (" 4))
    (topmost-cont c-lineup-topmost-intro-cont topmost-intro-cont ("Bar," 0) ("int throws" 0) nil)
    (throws c-lineup-java-throws func-decl-cont ("Bar," 0) ("int throws" 0) nil)
    (java-inher c-lineup-java-inher inher-cont ("Bar," 0) ("throws Cyphr" 0) nil)
    (snug-do-while c-snug-do-while block-close ("x++;" 0) ("}\n  while (x < 10)" 0) nil
                   (block-close "}\n  while (x < 10)" 0))
    (gnu-min c-gnu-impose-minimum defun-block-intro ("return result;" 0) ("return result;" 0) nil
             (defun-block-intro "return result;" 0))
    (semi-inside-parens c-semi&comma-inside-parenlist nil ("list))" 0) nil nil)
    (semi-inside-block c-semi&comma-inside-parenlist nil ("return result;" 0) nil nil)
    (semi-nonblanks-blank c-semi&comma-no-newlines-before-nonblanks nil ("return result;" 0) nil nil)
    (semi-nonblanks-nonblank c-semi&comma-no-newlines-before-nonblanks nil ("x++;" 0) nil nil)
    (respect-col-0 c-lineup-respect-col-0 comment-intro ("/* A comment" 0) ("/* A comment" 0) nil)
    (under-anchor c-lineup-under-anchor statement-cont ("+ c;" 0) ("+ c;" 0) nil)
    (dont-change c-lineup-dont-change statement-cont ("+ c;" 0) ("+ c;" 0) nil)
    (whitesmith c-lineup-whitesmith-in-block brace-list-intro ("{ 17," 0) ("{ 17," 0) nil)
    (after-whitesmith c-lineup-after-whitesmith-blocks brace-list-entry ("18" 0) ("{ 17," 0) nil)
    (objc-call c-lineup-ObjC-method-call objc-method-call-cont ("barBaz: barney" 0) ("[foo" 0) nil)
    (objc-call-colons c-lineup-ObjC-method-call-colons objc-method-call-cont ("barBaz: barney" 0) ("[foo" 0) nil)
    (objc-args c-lineup-ObjC-method-args objc-method-args-cont ("barBaz: barney" 0) ("[foo" 0) nil)
    (objc-args-2 c-lineup-ObjC-method-args-2 objc-method-args-cont ("barBaz: barney" 0) ("[foo" 0) nil)))

(defconst cases-cpp
  '((template-args c-lineup-template-args template-args-cont ("typename U>" 0) ("template <" 0) ("template <" 9))
    (template-margin c-lineup-template-args-indented-from-margin template-args-cont ("char> (1)" 0) ("foo<int" 0) ("foo<int" 3))
    (class-field c-lineup-class-field-cont class-field-cont ("typename U>" 0) ("template <" 0) nil)
    (inexpr c-lineup-inexpr-block inlambda ("return x + n;" 0) nil nil)
    (brace-2nd c-lineup-2nd-brace-entry-in-arglist brace-list-intro ("point_t{0.2, 0.5}," 0)
               ("set_line (" 0) ("line_t {point_t{0.4" 7)
               (brace-list-intro "line_t {point_t{0.4" 0)
               (brace-list-entry "point_t{0.4" 0)
               (arglist-cont-nonempty "set_line (" 0))
    (class-init-plus c-lineup-class-decl-init-+ brace-list-intro ("3.1" 0)
                     ("str_4 = {2," 0) ("str_4 = {2," 8)
                     (brace-list-intro "str_4 = {2," 0)
                     (brace-list-entry "str_4 = {2," 9))
    (class-init-after c-lineup-class-decl-init-after-brace brace-list-intro ("3.1" 0)
                      ("str_4 = {2," 0) ("str_4 = {2," 8)
                      (brace-list-intro "str_4 = {2," 0)
                      (brace-list-entry "str_4 = {2," 9))
    (semi-oneline c-semi&comma-no-newlines-for-oneline-inliners nil ("return;" 7) nil nil)))

(defun needle (spec)
  (when spec
    (save-excursion
      (goto-char (point-min))
      (unless (search-forward (nth 0 spec) nil t)
        (error "Missing needle %S" spec))
      (+ (match-beginning 0) (nth 1 spec)))))

(defun pr (x)
  (cond ((null x) (princ "nil"))
        ((symbolp x) (princ (symbol-name x)))
        ((numberp x) (princ (number-to-string x)))
        ((vectorp x)
         (princ "[")
         (dotimes (i (length x))
           (when (> i 0) (princ " "))
           (pr (aref x i)))
         (princ "]"))
        ((consp x)
         (princ "(")
         (pr (car x))
         (setq x (cdr x))
         (while (consp x)
           (princ " ")
           (pr (car x))
           (setq x (cdr x)))
         (princ ")"))
        (t (prin1 x))))

(let* ((file (car command-line-args-left))
       (cpp (equal (cadr command-line-args-left) "cpp")))
  (find-file file)
  (if cpp (c++-mode) (c-mode))
  (c-set-style "gnu")
  (setq c-label-minimum-indentation 4)
  (dolist (case (if cpp cases-cpp cases-c))
    (let* ((name (nth 0 case))
           (fn (nth 1 case))
           (sym (nth 2 case))
           (at (needle (nth 3 case)))
           (anchor (needle (nth 4 case)))
           (second (needle (nth 5 case)))
           (ctxs (nthcdr 6 case)))
      (goto-char at)
      (let ((c-syntactic-element
             (if sym (if second (list sym anchor second) (list sym anchor)) nil))
            (c-syntactic-context
             (mapcar (lambda (spec) (list (car spec) (needle (cdr spec))))
                     ctxs))
            (last-command-event ?\;))
        (princ (format "%s " name))
        (condition-case _e
            (cond
             ((eq fn 'c-gnu-impose-minimum)
              (funcall fn)
              (pr (current-indentation)))
             ((memq fn '(c-semi&comma-inside-parenlist
                         c-semi&comma-no-newlines-before-nonblanks
                         c-semi&comma-no-newlines-for-oneline-inliners))
              (pr (funcall fn)))
             (t
              (let ((langelem (if anchor (cons sym anchor) (list sym))))
                (pr (funcall fn langelem)))))
          (error (princ "error")))
        (terpri)))))
