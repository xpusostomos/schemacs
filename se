#!/usr/bin/env -S GUILE_WARN_DEPRECATED=no guile --no-auto-compile --r7rs
!#
;;--------------------------
;; se - the schemacs editor
;;--------------------------
;;
;; A Guile script, not a shell one, so that the editor is started by the
;; same interpreter that runs it and there is no second process in the
;; way. It does the two things that have to happen before the editor's own
;; code is loaded, and nothing else:
;;
;;   * puts this tree, and the *built* guile-cairo under it, first on the
;;     load path. The tree's copy is a newer guile-cairo than the packaged
;;     one: it has `cairo-pointer->context', which is what wraps the cairo
;;     context Gtk hands the `draw' signal. `schemacs/main.scm' checks for
;;     it, when a window is what was asked for, and says how to build it.
;;   * loads `schemacs/main.scm', which reads the command line and starts
;;     the front end it names.
;;
;; `GUILE_WARN_DEPRECATED=no' is in the `#!' line rather than set from
;; Scheme because the guile-ncurses bindings emit a deprecation warning as
;; they are *compiled*, which is before any top-level form here would run
;; - and that warning garbles the first screen paint.
;;
;; Usage is `schemacs/main.scm''s:
;;
;;     se [OPTION]... [FILE]...
;;     se -w FILE           the Gtk window (the terminal is the default)
;;     se --chdir=/tmp FILE
;;
;; With no FILE it shows the startup screen - the text of a `splash.txt'
;; found on the load path (`schemacs/editor/startup.sld'), which is the
;; whole window when it is all there is and the lower one when files were
;; named. An init file turns it off by importing `(schemacs editor startup)'
;; - that is the library `startup.el''s variable lives in - and setting
;; `inhibit-startup-screen'.
;;
;; A running editor can be driven through a back door, off unless asked
;; for: `se -w --server FILE &' then `tools/repl.py '(render! (*current-frame*))',
;; or the terminal's own `se --repl'. The session is given the editor's
;; names as the door opens, so an expression needs no import.
;; `se --remote FILE...' is the other end of the same door with no REPL in
;; it: the files are opened in the running editor's `find-file'.
;; For the Gtk backend that is the *only* reliable way to drive it - the
;; alternative is a compositor, `wtype' to type at the window and `grim' to
;; look at it, and a keyed run goes to whichever window the compositor has
;; focused, which is not necessarily this one. A silent mis-focus then
;; produces a screenshot of something else that looks exactly like
;; evidence. A REPL cannot mis-focus: it is the process. See AGENTS.md.
;;
;; It is the *cooperative* REPL server and not `guile --listen', which
;; would put the REPL in a thread of its own - and a parameter binding is
;; thread-local, so that thread sees the default of everything the editor
;; parameterized. See the header of `schemacs/repl.sld'.
;;------------------------------------------------------------------

(import ;; As in `schemacs/main.scm': `error' and `raise' are core bindings
        ;; in `(guile-user)', and this file is loaded into it - importing
        ;; `(scheme base)' on top of them makes Guile warn that it
        ;; "overrides core binding". Nothing here uses either.
        (except (scheme base) error raise)
        (scheme write)
        (only (guile) %load-path canonicalize-path dirname))

;; This script's own directory, which is the tree's root: the load path
;; has to hold it *before* `schemacs/main.scm' is loaded, because that is
;; where its imports resolve from.
;;
;; `(car (command-line))' is this file as it was invoked, so it is
;; resolved against the working directory - the same assumption the shell
;; version made with `dirname "$0"'. Run it by name from `PATH' and this
;; is the wrong directory; run it as `./se', as everything here does, and
;; it is the right one.
(define tree (dirname (canonicalize-path (car (command-line)))))

(define cairo (string-append tree "/.guile-cairo/share/guile/site/3.0"))

(set! %load-path (cons tree (cons cairo %load-path)))

(load (string-append tree "/schemacs/main.scm"))
