(define (n->f x) (if (or (eq? x 'nil) (null? x)) #f x))
(define (codes->string codes)
  (apply string (map integer->char codes)))

(define (run-case test)
  (let* ((rule (n->f (list-ref test 0)))
         (codes (list-ref test 1))
         (pos (list-ref test 2))
         (col (n->f (list-ref test 3)))
         (line (n->f (list-ref test 4)))
         (file (n->f (list-ref test 5)))
         (type (n->f (list-ref test 6)))
         (buf (allocate-buffer)))
    (set-buffer buf)
    (set!compilation-locs (make-hash-table))
    (insert (codes->string codes))
    (compilation-parse-errors (point-min) (point-max))
    (let ((msg (get-text-property pos 'compilation-message)))
      (test-assert (format #f "~a @~a: message property" rule pos)
                   (compilation--message? msg))
      (when (compilation--message? msg)
        (let* ((loc (compilation--message->loc msg))
               (ec (if (pair? col) (n->f (car col)) col))
               (el (if (pair? line) (n->f (car line)) line))
               (end-line (and (pair? line) (integer? (cdr line))
                              (cdr line))))
          (test-equal (format #f "~a @~a: column" rule pos)
                      ec (compilation--loc->col loc))
          (test-equal (format #f "~a @~a: line" rule pos)
                      el (compilation--loc->line loc))
          (when file
            (test-equal (format #f "~a @~a: file" rule pos)
                        file (caar (compilation--loc->file-struct loc))))
          (when (pair? col)
            (let ((fs (compilation--loc->file-struct loc)))
              (test-equal (format #f "~a @~a: end-column" rule pos)
                          (n->f (cdr col))
                          (1- (car (cadr (list-ref fs 2)))))))
          (let ((fs (compilation--loc->file-struct loc)))
            (test-equal (format #f "~a @~a: first line key" rule pos)
                        (or end-line el) (car (list-ref fs 2))))
          (when type
            (test-equal (format #f "~a @~a: type" rule pos)
                        (cond ((eq? type 'info) 0)
                              ((eq? type 'warning) 1)
                              ((eq? type 'error) 2)
                              (else type))
                        (compilation--message->type msg)))
          (test-equal (format #f "~a @~a: rule" rule pos)
                      rule (compilation--message->rule msg)))))))

(test-begin "schemacs_progmodes_compile")

(for-each run-case compile-tests--test-regexps-data)

;;--------------------------------------------------------------
;; The mode and the navigation (`compile.el:2451'-`:2675',
;; `:2844'-`:2954').  The positions below are the ones the parser
;; above gives the two messages in this text.
;;--------------------------------------------------------------
(test-begin "schemacs_progmodes_compile_mode")
(let ((b (allocate-buffer)))
  (set-buffer b)
  (insert "foo.c:3: error: bad\nbar.c:9: warning: meh\n")
  (compilation-mode)
  (test-equal "major mode" 'compilation-mode (major-mode))
  (test-equal "mode name" "Compilation" (mode-name))
  (test-assert "the buffer is read-only" (buffer-read-only? b))
  (test-assert "the loc hash exists" (compilation-locs))
  (test-assert "it is a compilation buffer" (compilation-buffer-p b))
  (test-assert "next-error-function is set"
               (procedure? (next-error-function)))
  (compilation--ensure-parse (point-max))
  (test-assert "the first message parsed"
               (compilation--message?
                (get-text-property 1 'compilation-message)))
  (test-assert "the second message parsed"
               (compilation--message?
                (get-text-property 21 'compilation-message)))
  (goto-char (point-min))
  (compilation-next-error 1 #f (point-min))
  (test-equal "next-error goes to the second message" 21 (point))
  (compilation-previous-error 1)
  (test-equal "previous-error comes back" 1 (point)))
(test-end "schemacs_progmodes_compile_mode")

;;--------------------------------------------------------------
;; Rules whose FILE, LINE and COLUMN are functions
;; (`compile-tests.el:604').
;;--------------------------------------------------------------
(test-begin "schemacs_progmodes_compile_functions")
(let ((b (allocate-buffer)))
  (set-buffer b)
  (set!compilation-locs (make-hash-table))
  (insert "My error message")
  (compilation-parse-errors
   (point-min) (point-max)
   (list "My error message"
         (lambda () '("my-file"))
         (cons (lambda () 123) (lambda () 134))
         (cons (lambda () 39) (lambda () 24))
         2))
  (let* ((msg (get-text-property 1 'compilation-message))
         (loc (compilation--message->loc msg))
         (end (compilation--message->end-loc msg)))
    (test-assert "a message was parsed" (compilation--message? msg))
    (test-equal "file from a function" "my-file"
                (caar (compilation--loc->file-struct loc)))
    (test-equal "line from a function" 123 (compilation--loc->line loc))
    (test-equal "column from a function" 39 (compilation--loc->col loc))
    (test-equal "end column is exclusive" 25 (compilation--loc->col end))
    (test-equal "end line" 134 (compilation--loc->line end))))
(test-end "schemacs_progmodes_compile_functions")

;;--------------------------------------------------------------
;; The mode's UI pieces the parser does not reach: the tool bar
;; map, the menu's Skip submenu, the mode line's process status, and
;; the two output-truncation paths of the process filter.
;;--------------------------------------------------------------
(test-begin "schemacs_progmodes_compile_ui")

;; The tool bar map: the global bar's Undo and second separator are
;; gone, the compile separator and the four items are in
;; (`compile.el:2494').
(test-equal "the tool bar's undo item is removed"
            #f (keymap-lookup compilation-mode-tool-bar-map (vector 'undo)))
(test-equal "the compile separator is there" '()
            (keymap-lookup compilation-mode-tool-bar-map
                           (vector 'separator-compile)))
(test-assert "Previous Error is a tool bar item"
             (procedure? (keymap-lookup compilation-mode-tool-bar-map
                                        (vector 'previous-error-no-select))))
(test-assert "Next Error is a tool bar item"
             (procedure? (keymap-lookup compilation-mode-tool-bar-map
                                        (vector 'next-error-no-select))))
(test-assert "Stop Compilation is a tool bar item"
             (procedure? (keymap-lookup compilation-mode-tool-bar-map
                                        (vector 'kill-compilation))))
(test-assert "Recompile is a tool bar item"
             (procedure? (keymap-lookup compilation-mode-tool-bar-map
                                        (vector 'recompile))))

;; The Skip submenu: the item is a lambda over `customize-set-variable`
;; (`compile.el:2360'), and the radio form reads the parameter.
(let ((skip (keymap-lookup compilation-menu-map (vector 'compilation-skip))))
  (test-assert "the Skip submenu exists"
               (keymap-lookup skip (vector 'compilation-skip-info)))
  ((keymap-lookup skip (vector 'compilation-skip-info)))
  (test-equal "Skip Info sets the threshold" 1
              (*compilation-skip-threshold*))
  (test-equal "and records the customized value" '(1)
              (get '*compilation-skip-threshold* 'customized-value))
  ((keymap-lookup skip (vector 'compilation-skip-warning-and-info)))
  (test-equal "Skip Warnings and Info sets it to 2" 2
              (*compilation-skip-threshold*))
  ((keymap-lookup skip (vector 'compilation-skip-none)))
  (test-equal "Don't Skip sets it to 0" 0
              (*compilation-skip-threshold*)))

;; The auto-error-display item's state reads the generated accessor.
(test-equal "next-error-follow-minor-mode is off in a fresh buffer"
            #f (next-error-follow-minor-mode-variable))

;; `compilation-mode-line-errors` is a construct whose numbers are
;; `:eval` procedures in this tree.
(test-equal "the mode line's error string starts with a space and ["
            " [" (car compilation-mode-line-errors))

;; `compilation-hidden-output`: the matches get `invisible' and
;; `rear-nonsticky' (`compile.el:2795').
(let ((b (allocate-buffer)))
  (set-buffer b)
  (insert "SECRET x\nvisible\n")
  (parameterize ((*compilation-hidden-output* "SECRET"))
    (compilation--hide-output (point-min)))
  (test-equal "the matched text is invisible" #t
              (get-text-property 1 'invisible))
  (test-equal "and leads with rear-nonsticky" #t
              (get-text-property 1 'rear-nonsticky))
  (test-equal "the rest of the line is not" #f
              (get-text-property 8 'invisible))
  (test-assert "invisible-p agrees" (invisible-p 1)))

;; `compilation--insert-abbreviated-line`: the tail past WIDTH gets the
;; display ellipsis and a button, and clicking it restores the text
;; (`compile.el:2795`'s buttonize-region callback).
(let ((b (allocate-buffer)))
  (set-buffer b)
  (compilation--insert-abbreviated-line "0123456789\n" 4)
  (test-equal "point is after the inserted newline" 12 (point))
  (test-equal "the tail carries the display ellipsis" "[…]"
              (get-text-property 5 'display))
  (test-equal "and is a button" #t (get-text-property 5 'button))
  (push-button 5 #f)
  (test-equal "clicking it removes the display property" #f
              (get-text-property 5 'display))
  (test-equal "and the button property" #f
              (get-text-property 5 'button)))

(test-end "schemacs_progmodes_compile_ui")

;;----------------------------------------------------------------------
;; `compilation-beginning-of-line' (`compile.el:1578') and its
;; `selective-display' arm.  Measured on Emacs 31.1 on "aa\rbb\rcc\ndd":
;; with the variable nil a CR is ordinary text, and with it t the CR is
;; a line boundary for this motion.
(test-begin "schemacs_progmodes_compile_begline")
(let ((b (allocate-buffer)))
  (set-buffer b)
  (insert "aa\rbb\rcc\ndd")
  (test-equal "with selective-display nil a CR is not a line break"
              (list 10 1)
              (list (begin (goto-char 1) (compilation-beginning-of-line 2) (point))
                    (begin (goto-char 1) (compilation-beginning-of-line 0) (point))))
  (set-buffer-local-value! b 'selective-display #t)
  (test-equal "with selective-display t the CR boundaries count"
              (list 4 3 7 12)
              (list (begin (goto-char 1) (compilation-beginning-of-line 2) (point))
                    (begin (goto-char 4) (compilation-beginning-of-line 0) (point))
                    (begin (goto-char 4) (compilation-beginning-of-line 2) (point))
                    (begin (goto-char 10) (compilation-beginning-of-line 2) (point))))
  (test-equal "a negative N lands at the beginning of that line"
              (list 1 1)
              (list (begin (goto-char 8) (compilation-beginning-of-line -1) (point))
                    (begin (goto-char 8) (compilation-beginning-of-line -2) (point))))
  (test-equal "no N is the ordinary beginning-of-line"
              (list 1 10)
              (list (begin (goto-char 4) (compilation-beginning-of-line) (point))
                    (begin (goto-char 10) (compilation-beginning-of-line) (point)))))
(test-end "schemacs_progmodes_compile_begline")

;;----------------------------------------------------------------------
;; The two compilation minor modes.  They are `define-minor-mode`s now:
;; the hand-written commands ran `compilation-setup` but never set the
;; mode variable, so `'toggle` could only ever enable, and the lighter
;; and the mode's own keys were missing.
(test-begin "schemacs_progmodes_compile_minor_modes")
(let ((b (allocate-buffer)))
  (set-buffer b)
  (test-equal "the shell minor mode starts off" #f
              (compilation-shell-minor-mode-variable))
  (test-equal "enabling returns the new setting" #t
              (compilation-shell-minor-mode #t))
  (test-equal "the variable is set" #t
              (compilation-shell-minor-mode-variable))
  (test-equal "its lighter is registered" " Shell-Compile"
              (let ((e (assq 'compilation-shell-minor-mode
                             (*minor-mode-alist*))))
                (and e (cadr e))))
  (test-equal "and its keys resolve while it is on" #t
              (if (eq? (key-binding (kbd "M-C-m")) compile-goto-error) #t #f))
  (compilation-shell-minor-mode 'toggle)
  (test-equal "toggling turns it off" #f
              (compilation-shell-minor-mode-variable))
  (test-equal "and its keys stop resolving" #f
              (key-binding (kbd "M-C-m")))
  (compilation-minor-mode #t)
  (test-equal "the compilation minor mode's variable and lighter"
              (list #t " Compilation")
              (list (compilation-minor-mode-variable)
                    (let ((e (assq 'compilation-minor-mode
                                   (*minor-mode-alist*))))
                      (and e (cadr e))))))
(test-end "schemacs_progmodes_compile_minor_modes")

(test-end "schemacs_progmodes_compile")
