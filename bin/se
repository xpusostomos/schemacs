#!/usr/bin/env -S GUILE_WARN_DEPRECATED=no guile --no-auto-compile
!#
;;--------------------------
;; se - the schemacs editor
;;--------------------------
;;
;; A Guile script, not a shell one, so that the editor is started by the
;; same interpreter that runs it and there is no second process in the
;; way. It does the two things that have to happen before the editor's own
;; code is loaded, and nothing else:
;;
;;   * puts this tree - or, for an installed `se', its prefix's site
;;     directory - first on the load path, because that is where the
;;     editor's libraries resolve from;
;;   * loads `schemacs/main.scm', which reads the command line and starts
;;     the front end it names.
;;
;; **It is one launcher for both, and `bin/' is where the Makefile
;; installs launchers from.** `here` is this file's directory and `prefix`
;; is the tree in a checkout, or the install prefix once installed, so the
;; same file does both jobs - `make install` puts it in `$(BINDIR)/se`.
;;
;; **The cairo library is *not* searched for here.** The Gtk front end
;; needs a guile-cairo newer than some packaged ones (it is what has
;; `cairo-pointer->context', which wraps the cairo context Gtk hands the
;; draw signal); that is a property of the *installation*, so it belongs
;; on Guile's own load path and not in a directory this script knows
;; about. `check-cairo!` in `schemacs/main.scm' is what says so when it is
;; missing.
;;
;; `GUILE_WARN_DEPRECATED=no' is in the `#!' line rather than set from
;; Scheme because the guile-ncurses bindings emit a deprecation warning as
;; they are *compiled*, which is before any top-level form here would run
;; - and that warning garbles the first screen paint.
;;
;; Usage is `schemacs/main.scm''s:
;;
;;     se [OPTION]... [FILE]...
;;     se -w FILE           the Gtk window (the terminal is the default)
;;     se --chdir=/tmp FILE
;;
;; With no FILE it shows the startup screen - the text of a `splash.txt'
;; found on the load path (`schemacs/editor/startup.scm'), which is the
;; whole window when it is all there is and the lower one when files were
;; named. An init file turns it off by importing `(schemacs editor startup)'
;; - that is the library `startup.el''s variable lives in - and setting
;; `inhibit-startup-screen'.
;;
;; A running editor can be driven through a back door, off unless asked
;; for: `se -w --server FILE &' then `tools/repl.py '(render! (*current-frame*))',
;; or the terminal's own `se --repl'. The session is given the editor's
;; names as the door opens, so an expression needs no import.
;; `se --remote FILE...' is the other end of the same door with no REPL in
;; it: the files are opened in the running editor's `find-file'.
;; For the Gtk backend that is the *only* reliable way to drive it - the
;; alternative is a compositor, `wtype' to type at the window and `grim' to
;; look at it, and a keyed run goes to whichever window the compositor has
;; focused, which is not necessarily this one. A silent mis-focus then
;; produces a screenshot of something else that looks exactly like
;; evidence. A REPL cannot mis-focus: it is the process. See AGENTS.md.
;;
;; It is the *cooperative* REPL server and not `guile --listen', which
;; would put the REPL in a thread of its own - and a parameter binding is
;; thread-local, so that thread sees the default of everything the editor
;; parameterized. See the header of `schemacs/repl.scm'.
;;------------------------------------------------------------------
(import ;; **Nothing is imported from `(scheme base)' or `(scheme write)'**,
        ;; and that is the fix for a warning rather than a style choice -
        ;; `schemacs/main.scm' carries the whole of it, and its comment is
        ;; the one to read. In short: this file is loaded into
        ;; `(guile-user)', whose parent module is `(guile)' and which
        ;; therefore already has `filter', `member', `for-each', `append',
        ;; `display', `newline' and the rest; importing `(scheme base)' on
        ;; top of them makes Guile warn "imported module (scheme base)
        ;; overrides core binding `member'" the first time each name is
        ;; looked up, which for a launcher is at startup, on every start.
        ;;
        ;; What this file takes from `(guile)' is named, so that the
        ;; dependency is still on the record: `load' is the variable
        ;; transformer that compiles and caches the file it is given, which
        ;; is what makes a second start cheaper.
        (only (guile) %load-compiled-path %load-path dirname effective-version
              exit file-exists? in-vicinity load))

;; This file's own directory, and one above it: `.../bin' and the tree (or
;; the install prefix). `(current-filename)' and not `(car (command-line))'
;; - the latter is the file *as it was invoked*, so `PATH' or a relative
;; path changes what it names, and the installed `se' is started both ways.
(define here (dirname (current-filename)))       ; .../bin
(define prefix (dirname here))                   ; the tree, or the prefix

(define version (effective-version))
(define site (string-append prefix "/share/guile/site/" version))
(define ccache (string-append prefix "/lib/guile/" version "/site-ccache"))

(define load-roots
  ;; Where the editor's libraries can be, in the order to look: the tree
  ;; first, so that a checkout's `se' uses the checkout and not an
  ;; installed copy of itself, then the prefix's own site directory, which
  ;; is where `make install' puts them.
  ;;
  ;; One of the two exists in each case, and the filter is what lets this
  ;; file serve both without asking which it is.
  (filter (lambda (d) (and d (file-exists? d))) (list prefix site)))

(set! %load-path (append (filter (lambda (d) (not (member d %load-path)))
                                 load-roots)
                         %load-path))
(when (file-exists? ccache)
  (set! %load-compiled-path (cons ccache (delq ccache %load-compiled-path))))

(define (find-on-load-path name)
  ;; NAME below one of the roots above, or #f.
  ;;--------------------------------------------------------------
  (let lp ((dirs load-roots))
    (and (pair? dirs)
         (let ((file (in-vicinity (car dirs) name)))
           (if (file-exists? file) file (lp (cdr dirs)))))))

;; **`load', and not `use-modules'.** `schemacs/main.scm' is a *program*:
;; it has no `define-module', it reads the command line and starts an
;; editor as it is loaded, and its own comments say what it assumes - "this
;; file is loaded into `(guile-user)', where those are already bound"
;; (`main.scm:35'). Loading it here is that.
;;
;; It was `(use-modules (schemacs main) (main))' on 2026-10-10, and it
;; **deadlocks**: an editor started that way blocks on a futex before it
;; draws anything, as soon as `SCHEMACS_REPL' or `--server' asks for the
;; back door. The whole editor then runs inside the module resolution that
;; `use-modules' performs, and the door's accept thread - which the editor
;; starts before its first screen - waits on something that resolution
;; holds. Measured with a pty harness: no port file, no ncurses output, the
;; process in state `S' on `futex_do_wait', and keys only echoed by the
;; terminal. Without the door the same build draws its splash screen
;; normally. `(main)' is not a module that exists in the tree at all - it
;; would fail with "no code for module (main)" the first time the editor
;; returned from `run-command-line' rather than exiting.
(let ((entry (find-on-load-path "schemacs/main.scm")))
  (if entry
      (load entry)
      (begin
        (display "se: cannot find schemacs/main.scm on the load path - looked in:"
                 (current-error-port))
        (newline (current-error-port))
        (for-each (lambda (dir)
                    (display "    " (current-error-port))
                    (display dir (current-error-port))
                    (newline (current-error-port)))
                  load-roots)
        (exit 1))))
